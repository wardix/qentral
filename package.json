{
  "name": "qentral",
  "version": "1.0.0",
  "description": "Centralized background job processing system using Bun, Hono, BullMQ, and Redis",
  "type": "module",
  "private": true,
  "scripts": {
    "dev:web": "bun --watch src/server.ts",
    "dev:worker": "bun --watch src/worker.ts",
    "start:web": "bun src/server.ts",
    "start:worker": "bun src/worker.ts",
    "start": "bun run src/server.ts",
    "worker": "bun run src/worker.ts",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/ioredis-mock": "^8.2.8",
    "ioredis-mock": "^8.13.1"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "@bull-board/api": "^9.10.4",
    "@bull-board/hono": "^9.10.4",
    "@hono/bun": "^1.0.1",
    "bullmq": "^6.4.0",
    "hono": "^4.13.13",
    "ioredis": "^6.0.0"
  }
}
