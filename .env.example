# ==========================================
# Konfigurasi Server
# ==========================================
NODE_ENV=development
PORT=3000

# ==========================================
# Konfigurasi Redis Broker
# ==========================================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ==========================================
# Keamanan & Autentikasi
# ==========================================
# API Key untuk memproteksi endpoint POST /api/v1/jobs/*
API_KEY=ganti-dengan-kunci-rahasia-anda

# Kredensial Basic Auth untuk Dashboard Bull-Board (/ui)
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=adminpassword

# ==========================================
# Konfigurasi Worker & Retensi
# ==========================================
# Jumlah job yang dapat diproses bersamaan per instance worker
DEFAULT_WORKER_CONCURRENCY=5

# Batas riwayat job di Redis (mencegah memory leak)
JOB_RETENTION_COMPLETED_COUNT=1000
JOB_RETENTION_FAILED_COUNT=5000

# ==========================================
# Konfigurasi FBStar Reminder Job
# ==========================================
PROM_TICKETS_URL=https://metrics.example.com/operator-tickets
WA_API_URL=https://api.whatsapp.example.com/v2/messages
WA_API_TOKEN=your-wa-api-bearer-token
WA_FBSTAR_TARGET_NUMBER=628123456789@g.us
