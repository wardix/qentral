# ==========================================
# Konfigurasi Server
# ==========================================
NODE_ENV=development
PORT=3000

# ==========================================
# Konfigurasi Redis Broker
# ==========================================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ==========================================
# Keamanan & Autentikasi
# ==========================================
# API Key untuk memproteksi endpoint POST /api/v1/jobs/*
API_KEY=ganti-dengan-kunci-rahasia-anda

# Kredensial Basic Auth untuk Dashboard Bull-Board (/ui)
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=adminpassword

# ==========================================
# Konfigurasi Worker & Retensi
# ==========================================
# Jumlah job yang dapat diproses bersamaan per instance worker
DEFAULT_WORKER_CONCURRENCY=5

# Batas riwayat job di Redis (mencegah memory leak)
JOB_RETENTION_COMPLETED_COUNT=1000
JOB_RETENTION_FAILED_COUNT=5000

# ==========================================
# Konfigurasi FBStar Reminder Job
# ==========================================
PROM_TICKETS_URL=https://metrics.example.com/operator-tickets
WA_API_URL=https://api.whatsapp.example.com/v2/messages
WA_API_TOKEN=your-wa-api-bearer-token
WA_FBSTAR_TARGET_NUMBER=628123456789@g.us

# ==========================================
# Konfigurasi iForte Reminder Job
# ==========================================
NIS_IFORTE_TICKETS_URL=https://api.example.com/tickets/iforte
NIS_TOKEN=your_nis_token
WA_IFORTE_TARGET_NUMBER=628123456789@g.us

# ==========================================
# Konfigurasi Employee Ticket Summary Job
# ==========================================
NIS_EMPLOYEE_SUMMARY_URL=https://api.example.com/tickets/employee-summary
WA_TICKET_SUMMARY_TARGET_NUMBER=628123456789@g.us
DEFAULT_DEPARTMENT_ID=34
DEFAULT_EXCLUDED_EMPLOYEE_IDS=0200911,0202616

# ==========================================
# Konfigurasi iForte Zabbix Graphs Sync Job
# ==========================================
IFORTE_ZABBIX_URL=https://zabbix.example.com/api_jsonrpc.php
IFORTE_ZABBIX_USERNAME=your_zabbix_username
IFORTE_ZABBIX_PASSWORD=your_zabbix_password
IFORTE_ZABBIX_GRAPH_NAME_FILTER=NUSANET-
IFORTE_GRAPH_ID_PREFIX=iforte-
NIS_GRAPH_SYNC_URL=https://api.example.com/v1/sync/graphs

# ==========================================
# Konfigurasi Alert Silence Job
# ==========================================
SILENCE_ALERT_API_URL=https://alertmanager.example.com/api/v2/silences

# ==========================================
# Konfigurasi Employee Birthday Reminder Job
# ==========================================
NUSAWORK_TOKEN_API_URL=https://nusawork.example.com/auth/api/oauth/token
NUSAWORK_CLIENT_ID=your_nusawork_client_id
NUSAWORK_CLIENT_SECRET=your_nusawork_client_secret
NUSAWORK_EMPLOYEE_API_URL=https://nusawork.example.com/api/v4.1/employee/filter
BIRTHDAY_PIC_PHONES=["628123456789"]
BIRTHDAY_GIFT_VOUCHER_TEMPLATE_PATH=./assets/birthday-voucher-template.png
BIRTHDAY_GIFT_VOUCHER_PERIOD_DAYS=30
BIRTHDAY_WISHES="Happy birthday"
